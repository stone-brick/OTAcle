<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.otacle.remote.repository.DecisionLogMapper">
    <resultMap id="BaseResultMap" type="com.otacle.remote.model.DecisionLog">
        <id column="id" property="id"/>
        <result column="project_id" property="projectId"/>
        <result column="step" property="step"/>
        <result column="custom_data" property="customData"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        insert into decision_logs(project_id, step, custom_data, created_at)
        values(#{projectId}, #{step}, #{customData}, #{createdAt})
    </insert>

    <select id="selectByProjectId" resultMap="BaseResultMap">
        select * from decision_logs where project_id = #{projectId}
    </select>

    <delete id="deleteById">
        delete from decision_logs where id = #{id}
    </delete>
</mapper>